# --- Database (Postgres - Vercel Postgres / Neon / Supabase all work) ---
# DATABASE_URL: pooled connection (pgbouncer) - used at runtime by serverless functions.
# DIRECT_URL: direct/non-pooling connection - required by `prisma migrate deploy`.
# On Supabase: DATABASE_URL = "Transaction pooler" string (port 6543, pgbouncer=true),
# DIRECT_URL = "Direct connection" string (port 5432). On providers without a pooler
# (Neon, Vercel Postgres), both can be the same value.
DATABASE_URL="postgresql://user:password@localhost:5432/geolock?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/geolock?schema=public"

# --- Auth (dashboard sessions) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# --- Rate limiting / replay-nonce cache (Upstash Redis REST API) ---
# Optional in dev: falls back to an in-memory limiter/nonce store (single instance only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- IP Intelligence provider ---
# Supported: "ipapi" (ip-api.com, free tier, no key) | "ipinfo" (ipinfo.io, needs token, adds VPN/proxy/Tor/hosting privacy detection)
IP_INTEL_PROVIDER="ipapi"
IPINFO_TOKEN=""

# --- Reverse geocoding for GPS coordinates (BigDataCloud client API, free, no key required) ---
REVERSE_GEOCODE_BASE_URL="https://api.bigdatacloud.net/data/reverse-geocode-client"

# --- Verification token signing (short-lived anti-replay tokens) ---
VERIFICATION_TOKEN_SECRET="replace-with-openssl-rand-base64-32"

# --- Verzapay (billing: plan-upgrade payments, Mobile Money/card) ---
# Server-only, never NEXT_PUBLIC_ - see src/lib/verzapay.ts. Generate from the
# Verzapay Developer dashboard (shown once). Configure the webhook URL there as
# https://<your-deployment>/api/webhooks/verzapay (must be HTTPS).
VERZAPAY_SECRET_KEY=""

# --- Supabase project reference (not consumed by the app code today - Prisma
# talks to the Postgres database directly via DATABASE_URL/DIRECT_URL above).
# Kept here only so a future feature that needs the Supabase client SDK
# (e.g. Storage, Realtime) has these documented in one place.
# SECURITY: never prefix the service-role key, JWT secret, or DB password with
# NEXT_PUBLIC_ - that prefix ships a variable's value into the browser bundle.
# Only the anon/publishable keys are designed by Supabase to be public, and
# only once actual client-side supabase-js code reads them.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_SECRET_KEY=""
