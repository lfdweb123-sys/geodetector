# --- Database (Postgres - Vercel Postgres / Neon / Supabase all work) ---
DATABASE_URL="postgresql://user:password@localhost:5432/geolock?schema=public"

# --- Auth (dashboard sessions) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# --- Rate limiting / replay-nonce cache (Upstash Redis REST API) ---
# Optional in dev: falls back to an in-memory limiter/nonce store (single instance only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- IP Intelligence provider ---
# Supported: "ipapi" (ip-api.com, free tier, no key) | "ipinfo" (ipinfo.io, needs token, adds VPN/proxy/Tor/hosting privacy detection)
IP_INTEL_PROVIDER="ipapi"
IPINFO_TOKEN=""

# --- Reverse geocoding for GPS coordinates (BigDataCloud client API, free, no key required) ---
REVERSE_GEOCODE_BASE_URL="https://api.bigdatacloud.net/data/reverse-geocode-client"

# --- Verification token signing (short-lived anti-replay tokens) ---
VERIFICATION_TOKEN_SECRET="replace-with-openssl-rand-base64-32"
